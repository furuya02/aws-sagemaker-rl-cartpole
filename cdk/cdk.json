{
  "app": "pnpm exec ts-node --prefer-ts-exts bin/aws-sagemaker-rl-cartpole.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "pnpm-lock.yaml",
      "node_modules"
    ]
  },
  "context": {
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:target-partitions": ["aws"]
  }
}
